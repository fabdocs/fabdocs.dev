{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fabdocs-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "e4d1a3da53914754a5150f280174dd97"
    }
  ],
  "vars": {
    // Cloudflare Web Analytics beacon token — safe to commit, it's meant to
    // be publicly visible in the rendered page's <script data-cf-beacon>
    // tag. See README.md's Analytics section.
    "NEXT_PUBLIC_CF_BEACON_TOKEN": "db6b34a1826d433fbeefe4a0d84d6144"
  },
  "observability": {
    "enabled": true
  }
}
