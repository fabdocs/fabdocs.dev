{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fabdocs-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "e4d1a3da53914754a5150f280174dd97"
    }
  ],
  "observability": {
    "enabled": true
  }
}
